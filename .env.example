# Settings for Docker Compose (docker-compose.yml). Copy to .env and fill in; .env is ignored by git.
# For running the services without Docker, use backend/.env.example and frontend/.env.example instead.

# The address people open. Locally: http://localhost:8080. On a server: https://your.domain
PUBLIC_URL=http://localhost:8080

# Database (created automatically in the db container)
DB_NAME=shift_handover
DB_USER=shift
DB_PASSWORD=change-me-to-a-long-random-password

# Session tokens: a long random value, e.g. from `openssl rand -hex 32`
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h

# Web server. Locally leave as is. On a VPS with a domain: SITE_ADDRESS=your.domain, HTTP_PORT=80,
# HTTPS_PORT=443 and PUBLIC_URL=https://your.domain (Caddy then gets an HTTPS certificate itself).
# Behind a host that already provides HTTPS: keep SITE_ADDRESS=:80 and point the host at HTTP_PORT.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
# Proxies in front of the backend: 1 (Caddy). Add one if the host puts its own proxy in front.
TRUST_PROXY=1

# Speech-to-text model: large-v3-turbo (accurate, ~5 GB RAM total for inference) or small (lighter)
WHISPER_MODEL=large-v3-turbo

# Optional: Sign in with Google (also add PUBLIC_URL to the client's authorised JavaScript origins)
GOOGLE_CLIENT_ID=

# Optional: password-reset email. Empty SMTP_HOST prints emails in the backend logs instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
