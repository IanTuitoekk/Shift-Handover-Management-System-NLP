# Copy to .env and fill in. .env is ignored by git; never commit real secrets.

PORT=3000

# PostgreSQL (create the database and tables with: npm run db:setup)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shift_handover
DB_USER=postgres
DB_PASSWORD=change-me

# Python inference service (inference-service/)
INFERENCE_SERVICE_URL=http://localhost:8000

# Session tokens. Use a long random value, e.g. from: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Where the frontend runs (Socket.IO origins and links in emails)
FRONTEND_ORIGIN=http://localhost:5173
# FRONTEND_URL=http://localhost:5173

# Sign in with Google: OAuth client ID (Web application) from Google Cloud. Optional.
GOOGLE_CLIENT_ID=

# Password-reset email over SMTP. Leave SMTP_HOST empty to print emails in the console instead.
# Gmail: an app password from https://myaccount.google.com/apppasswords (needs 2-Step Verification).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Optional settings (defaults shown)
# PASSWORD_RESET_MINUTES=30
# DEFAULT_TASK_DUE_HOURS=12
# LOW_CONFIDENCE_THRESHOLD=0.6
# DAY_SHIFT_START=6
# NIGHT_SHIFT_START=18
# SHIFT_TIMEZONE=Africa/Nairobi
